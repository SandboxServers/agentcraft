# Copy to .env on the host and fill in. Never commit .env (it is gitignored).

# Required: you accept the Minecraft EULA (https://aka.ms/MinecraftEULA) by setting TRUE.
EULA=

# Host port players connect to.
AGENTCRAFT_PORT=25565

# JVM heap (-Xms/-Xmx). 3G suits a handful of studios; raise for more players.
MEMORY=3G

# RCON stays inside the container (never published). Setting a password enables consistent
# pre-update backups (save-off / save-all flush). Use a long random value.
RCON_PASSWORD=

# How many world backups to keep in the volume.
BACKUP_KEEP=14

# Pin a specific release instead of the rolling tag, e.g. ghcr.io/sandboxservers/agentcraft-server:2026-10-03.1
# AGENTCRAFT_IMAGE=
